     tooltip="Pair Study table chart par kahan dikhe. Scanner ke saath dono ON karein to alag position dein.")
heatmapOn = input.bool(true, "Heatmap Shading (correlation cells)", group=g9, display=display.none,
     tooltip="ON: correlation ke dabbe ka background value ke hisaab se green (positive) ya red (negative) shade hota hai; jitna gehra, utni strong correlation. OFF: sirf text ka color.")

//====================================================
// TABLE STYLE  (RB-A02 ka dark navy theme)
//====================================================
color cTitleBg = color.rgb(24, 38, 71)
color cSecBg   = color.rgb(42, 52, 84)
color cRowA    = color.rgb(22, 27, 40)
color cRowB    = color.rgb(31, 37, 54)
color cBorder  = color.rgb(58, 64, 84)
color cText    = color.rgb(235, 238, 245)
color cGrey    = color.rgb(165, 171, 190)
color cGreen   = color.rgb(0, 200, 110)
color cRed     = color.rgb(240, 62, 72)
color cYellow  = color.rgb(255, 214, 10)
color cShadeG  = color.rgb(0, 120, 75)
color cShadeR  = color.rgb(155, 36, 46)
color cBestBg  = color.rgb(20, 70, 50)

//====================================================
// DATA TYPE
//====================================================
type AssetData
    array<float> cl
    array<float> rt

//====================================================
// HELPER FUNCTIONS
//====================================================
f_pos(string s) =>
    switch s
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Middle Right"  => position.middle_right
        "Middle Left"   => position.middle_left
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        => position.top_right

f_size(string s) =>
    switch s
        "Tiny"  => size.tiny
        "Small" => size.small
        "Large" => size.large
        "Huge"  => size.huge
        => size.normal

string posScan = f_pos(scanPosStr)
string posPair = f_pos(pairPosStr)
string szScan  = f_size(scanSizeStr)
string szPair  = f_size(pairSizeStr)

f_date(int t) =>
    na(t) ? "N/A" : str.format_time(t, "yyyy-MM-dd HH:mm", displayTz)

f_c2(float v) =>
    na(v) ? "-" : (v > 0 ? "+" : "") + str.tostring(v, "0.00")

f_p2(float v) =>
    na(v) ? "-" : (v > 0 ? "+" : "") + str.tostring(v, "0.00") + "%"

f_short(string s) =>
    array<string> parts = str.split(s, ":")
    array.get(parts, array.size(parts) - 1)

f_clr(float v) =>
    na(v) ? cGrey : v >= 0.2 ? cGreen : v <= -0.2 ? cRed : cGrey

f_shade(float cv, float maxAbs, color base) =>
    color out = base
    if not na(cv) and maxAbs > 0
        float t = math.min(math.abs(cv) / maxAbs, 1.0)
        out := cv >= 0 ? color.from_gradient(t, 0.0, 1.0, base, cShadeG) : color.from_gradient(t, 0.0, 1.0, base, cShadeR)
    out

f_strength(float c) =>
    string s = "n/a"
    if not na(c)
        float a = math.abs(c)
        s := a >= strongThr ? "Strong" : a >= decoupleThr ? "Moderate" : a >= 0.1 ? "Weak" : "None"
        if c < 0 and a >= decoupleThr
            s += " (inverse)"
    s

// Trend: |corr| ka badlav + decouple check
f_trend(float nowC, float pastC, float pastMaxAbs) =>
    string t = "n/a"
    color col = cGrey
    if not na(nowC) and not na(pastC)
        float d = math.abs(nowC) - math.abs(pastC)
        if math.abs(nowC) < decoupleThr and not na(pastMaxAbs) and pastMaxAbs >= decoupleThr
            t := "Decoupled ✕"
            col := cRed
        else if d >= trendTol
            t := "Strengthening ▲"
            col := cGreen
        else if d <= -trendTol
            t := "Weakening ▼"
            col := cRed
        else
            t := "Stable ●"
            col := cGrey
    [t, col]

// Pearson stats: pairs (x[j], y[j + shiftY]) for j in [start, start + cnt - 1]
// returns [corr, beta(y on x), n, agree%]
f_stats(array<float> x, array<float> y, int start, int cnt, int shiftY, float minPct) =>
    float corr = na
    float beta = na
    float agree = na
    int n = 0
    if start >= 0 and cnt > 1 and start + cnt - 1 < array.size(x) and start + shiftY >= 0 and start + cnt - 1 + shiftY < array.size(y)
        float sx = 0.0
        float sy = 0.0
        float sxx = 0.0
        float syy = 0.0
        float sxy = 0.0
        int same = 0
        for j = start to start + cnt - 1
            float xv = array.get(x, j)
            float yv = array.get(y, j + shiftY)
            if not na(xv) and not na(yv)
                n += 1
                sx += xv
                sy += yv
                sxx += xv * xv
                syy += yv * yv
                sxy += xv * yv
                if xv * yv > 0
                    same += 1
        if n >= math.max(5, int(math.ceil(cnt * minPct / 100.0)))
            float mx = sx / n
            float my = sy / n
            float vx = sxx / n - mx * mx
            float vy = syy / n - my * my
            float cv = sxy / n - mx * my
            if vx > 0 and vy > 0
                corr := math.max(-1.0, math.min(1.0, cv / math.sqrt(vx * vy)))
                beta := cv / vx
            agree := same * 100.0 / n
    [corr, beta, n, agree]

// k >= 0 : A leads B by k bars | k < 0 : B leads A by |k| bars. e = end offset (0 = latest bar)
f_lagStats(array<float> a, array<float> b, int m, int e, int w, int k, float minPct) =>
    float cc = na
    float bb = na
    int nn = 0
    float gg = na
    int ak = math.abs(k)
    int st = m - e - ak - w
    if k >= 0
        [c1, b1, n1, g1] = f_stats(a, b, st, w, ak, minPct)
        cc := c1
        bb := b1
        nn := n1
        gg := g1
    else
        [c2, b2, n2, g2] = f_stats(b, a, st, w, ak, minPct)
        cc := c2
        bb := b2
        nn := n2
        gg := g2
    [cc, bb, nn, gg]

// Best lag (max |corr|) in [-L, L]  -> [bestK, bestCorr, corr0, betaAtBest, beta0]
f_best(array<float> a, array<float> b, int m, int e, int w, int L, float minPct) =>
    int bestK = 0
    float bestC = na
    float c0 = na
    float bestBeta = na
    float beta0 = na
    for k = -L to L
        [c, bt, n, g] = f_lagStats(a, b, m, e, w, k, minPct)
        if k == 0
            c0 := c
            beta0 := bt
        if not na(c)
            if na(bestC) or math.abs(c) > math.abs(bestC)
                bestC := c
                bestK := k
                bestBeta := bt
    [bestK, bestC, c0, bestBeta, beta0]

// Leader sirf tab maana jaye jab lag par corr, lag-0 se leadEdge zyada ho
f_effK(int k, float bc, float c0) =>
    (not na(bc) and not na(c0) and k != 0 and math.abs(bc) - math.abs(c0) >= leadEdge) ? k : 0

// Window ka compounded return % (log returns ka sum)
f_sumRet(array<float> a, int m, int e, int w) =>
    float res = na
    int st = m - e - w
    if st >= 0
        float s = 0.0
        int n = 0
        for j = st to st + w - 1
            float v = array.get(a, j)
            if not na(v)
                s += v
                n += 1
        if n > 0
            res := (math.exp(s) - 1.0) * 100.0
    res

// Window ki volatility (stdev of returns, % per bar)
f_stdev(array<float> a, int m, int e, int w) =>
    float res = na
    int st = m - e - w
    if st >= 0
        float s = 0.0
        float ss = 0.0
        int n = 0
        for j = st to st + w - 1
            float v = array.get(a, j)
            if not na(v)
                s += v
                ss += v * v
                n += 1
        if n > 2
            float mean = s / n
            res := math.sqrt(math.max(ss / n - mean * mean, 0.0)) * 100.0
    res

f_lagTime(int k) =>
    string s = "-"
    if k == 0
        s := "0"
    else
        float sec = math.abs(k) * timeframe.in_seconds()
        if sec >= 86400
            s := str.tostring(sec / 86400.0, "0.0") + " day"
        else if sec >= 3600
            s := str.tostring(sec / 3600.0, "0.0") + " hr"
        else
            s := str.tostring(sec / 60.0, "0") + " min"
    s

//---------------- table helpers ----------------
f_cell(table t, int c, int r, string txt, color tc, color bg, string ha, string sz, bool bold) =>
    table.cell(t, c, r, txt, text_color=tc, bgcolor=bg, text_halign=ha, text_size=sz, text_formatting=bold ? text.format_bold : text.format_none)

f_title(table t, int row, int nCols, string txt, string sz) =>
    f_cell(t, 0, row, txt, cText, cTitleBg, text.align_center, sz, true)
    for c = 1 to nCols - 1
        f_cell(t, c, row, "", cText, cTitleBg, text.align_center, sz, false)
    table.merge_cells(t, 0, row, nCols - 1, row)

f_sec(table t, int row, int nCols, string txt, string sz) =>
    f_cell(t, 0, row, txt, cYellow, cTitleBg, text.align_left, sz, true)
    for c = 1 to nCols - 1
        f_cell(t, c, row, "", cYellow, cTitleBg, text.align_left, sz, false)
    table.merge_cells(t, 0, row, nCols - 1, row)

f_info(table t, int row, int nCols, string lbl, string val, color vc, string sz) =>
    color bg = row % 2 == 0 ? cRowA : cRowB
    f_cell(t, 0, row, lbl, cText, bg, text.align_left, sz, false)
    f_cell(t, 1, row, val, vc, bg, text.align_right, sz, false)
    for c = 2 to nCols - 1
        f_cell(t, c, row, "", cText, bg, text.align_right, sz, false)
    table.merge_cells(t, 1, row, nCols - 1, row)

f_row(table t, int row, array<string> txt, array<color> tcs, color bg, bool isHead, string sz) =>
    for c = 0 to array.size(txt) - 1
        string ha = c == 0 ? text.align_left : (isHead ? text.align_center : text.align_right)
        f_cell(t, c, row, array.get(txt, c), array.get(tcs, c), bg, ha, sz, isHead)

// correlation cell with optional heatmap
f_corrCell(table t, int c, int r, float v, color rowBg, string sz) =>
    string txt = f_c2(v)
    color bg = heatmapOn ? f_shade(v, 1.0, rowBg) : rowBg
    color tc = heatmapOn ? (na(v) ? cGrey : cText) : f_clr(v)
    f_cell(t, c, r, txt, tc, bg, text.align_right, sz, false)

//====================================================
// CHART FIRST CANDLE / RANGE
//====================================================
var int chartFirstTime = na
if na(chartFirstTime)
    chartFirstTime := time

int fromDate = useChartFirstAsFrom ? chartFirstTime : manualFromDate
bool inRange = time >= fromDate and time <= toDate

var int fromBarIdx = na
if inRange and na(fromBarIdx)
    fromBarIdx := bar_index

//====================================================
// ASSET DATA COLLECTION
//====================================================
var array<string> symAll  = array.from(s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20)
var array<string> nameAll = array.new_string()
var array<AssetData> store = array.new<AssetData>()

if barstate.isfirst
    for i = 0 to 19
        array.push(nameAll, f_short(array.get(symAll, i)))
    for i = 0 to nAssets - 1
        array.push(store, AssetData.new(array.new_float(), array.new_float()))

array<float> closes = array.new_float()
for i = 0 to nAssets - 1
    array.push(closes, request.security(array.get(symAll, i), timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off))

bool recBar = inRange and barstate.isconfirmed

if recBar
    for i = 0 to nAssets - 1
        AssetData ad = array.get(store, i)
        float c = array.get(closes, i)
        int mm = array.size(ad.cl)
        float prev = mm > 0 ? array.get(ad.cl, mm - 1) : na
        float rtv = na
        if not na(c) and not na(prev) and c > 0 and prev > 0
            if not (ignoreStale and c == prev)
                rtv := math.log(c / prev)
        if mm > 0
            array.push(ad.rt, rtv)
        array.push(ad.cl, c)

f_nm(int i) =>
    array.get(nameAll, i)

f_leader(int ia, int ib, int k) =>
    string s = "Simultaneous"
    if k > 0
        s := f_nm(ia) + " → " + f_nm(ib)
    else if k < 0
        s := f_nm(ib) + " → " + f_nm(ia)
    s

//====================================================
// TABLES  (sirf last bar par)
//====================================================
var table tblScan = na
var table tblPair = na

if barstate.islast
    if not na(tblScan)
        table.delete(tblScan)
        tblScan := na
    if not na(tblPair)
        table.delete(tblPair)
        tblPair := na

    AssetData ad0 = array.get(store, 0)
    int m = array.size(ad0.rt)
    int totalPairs = nAssets * (nAssets - 1) / 2

    //------------------------------------------------
    // SCAN (sab pairs)
    //------------------------------------------------
    array<int>   mA    = array.new_int(0)
    array<int>   mB    = array.new_int(0)
    array<float> mC    = array.new_float(0)
    array<float> mP    = array.new_float(0)
    array<float> mPMax = array.new_float(0)
    array<int>   mK    = array.new_int(0)
    array<float> mKC   = array.new_float(0)

    bool needScan = showScanner or studyRank > 0
    if needScan and m >= scanW
        for i = 0 to nAssets - 2
            AssetData ai = array.get(store, i)
            for j = i + 1 to nAssets - 1
                AssetData aj = array.get(store, j)
                [c0, b0, n0, g0] = f_stats(ai.rt, aj.rt, m - scanW, scanW, 0, minValidPct)
                bool ok = not na(c0) and math.abs(c0) >= minAbsCorr and (dirStr == "Both" or (dirStr == "Positive (follow)" and c0 > 0) or (dirStr == "Negative (inverse)" and c0 < 0))
                if ok
                    [pc, pb, pn, pg] = f_stats(ai.rt, aj.rt, m - trendShift - scanW, scanW, 0, minValidPct)
                    [bk, bc, cz, bb, bz] = f_best(ai.rt, aj.rt, m, 0, scanW, maxLag, minValidPct)
                    int ek = f_effK(bk, bc, cz)
                    array.push(mA, i)
                    array.push(mB, j)
                    array.push(mC, c0)
                    array.push(mP, pc)
                    array.push(mPMax, na(pc) ? na : math.abs(pc))
                    array.push(mK, ek)
                    array.push(mKC, ek == 0 ? cz : bc)

    int matchedN = array.size(mA)

    array<int> srt = array.new_int(0)
    if matchedN > 0
        array<float> keys = array.new_float(matchedN, 0.0)
        for q = 0 to matchedN - 1
            float cNow = array.get(mC, q)
            float cPast = array.get(mP, q)
            float dAbs = (na(cPast) ? 0.0 : math.abs(cNow) - math.abs(cPast))
            float key = math.abs(cNow)
            if sortStr == "Correlation (high to low)"
                key := cNow
            else if sortStr == "Correlation (low to high)"
                key := -cNow
            else if sortStr == "Strengthening first"
                key := dAbs
            else if sortStr == "Weakening first"
                key := -dAbs
            array.set(keys, q, key)
        srt := array.sort_indices(keys, order.descending)

    int perPage = rowsPerPage <= 0 ? math.max(matchedN, 1) : rowsPerPage
    int pages = math.max(1, int(math.ceil(matchedN * 1.0 / perPage)))
    int pg = math.min(math.max(pageNo, 1), pages)
    int startI = (pg - 1) * perPage
    int endI = math.min(startI + perPage, matchedN) - 1
    string pageTxt = "Page " + str.tostring(pg) + " / " + str.tostring(pages)

    //------------------------------------------------
    // SCANNER TABLE
    //------------------------------------------------
    if showScanner
        tblScan := table.new(posScan, 8, 16 + math.max(perPage, 1), border_color=cBorder, border_width=1, frame_color=cBorder, frame_width=1)
        int nr = 0
        f_title(tblScan, nr, 8, "CORRELATION SCANNER  |  " + timeframe.period + "  |  " + str.tostring(scanW) + " bars", szScan)
        nr += 1
        f_info(tblScan, nr, 8, "Chart First Candle", f_date(chartFirstTime), cYellow, szScan)
        nr += 1
        f_info(tblScan, nr, 8, "Selected From", f_date(fromDate), cText, szScan)
        nr += 1
        f_info(tblScan, nr, 8, "Selected To", f_date(toDate), cText, szScan)
        nr += 1
        f_info(tblScan, nr, 8, "Assets | Pairs Scanned", str.tostring(nAssets) + "  |  " + str.tostring(totalPairs), cText, szScan)
        nr += 1
        f_info(tblScan, nr, 8, "Filter", dirStr + "  |  |Corr| >= " + str.tostring(minAbsCorr, "0.00") + "  |  Trend shift " + str.tostring(trendShift), cText, szScan)
        nr += 1
        f_info(tblScan, nr, 8, "Pairs Matched", str.tostring(matchedN) + "  |  Bars in range: " + str.tostring(m + 1), matchedN > 0 ? cGreen : cYellow, szScan)
        nr += 1
        if m < scanW
            f_info(tblScan, nr, 8, "Warning", "Data kam: " + str.tostring(m) + " bars, Scan Window " + str.tostring(scanW) + " chahiye", cRed, szScan)
            nr += 1
        else if m < scanW + trendShift
            f_info(tblScan, nr, 8, "Note", "Trend ke liye " + str.tostring(scanW + trendShift) + " bars chahiye (abhi " + str.tostring(m) + ")", cYellow, szScan)
            nr += 1
        if pages > 1
            f_info(tblScan, nr, 8, "Page", pageTxt + "  (Settings me Page No. badlein)", cYellow, szScan)
            nr += 1
        f_info(tblScan, nr, 8, "Tip", "Deep study: Study Pair From Scanner Rank me # daalein", cGrey, szScan)
        nr += 1

        f_row(tblScan, nr, array.from("#", "Asset A", "Asset B", "Corr", "Past Corr", "Δ|Corr|", "Trend", "Lead-Lag"), array.from(cText, cText, cText, cText, cText, cText, cText, cText), cSecBg, true, szScan)
        nr += 1

        if matchedN > 0
            for i = startI to endI
                int qi = array.get(srt, i)
                int ia = array.get(mA, qi)
                int ib = array.get(mB, qi)
                float cn = array.get(mC, qi)
                float cp = array.get(mP, qi)
                float cpm = array.get(mPMax, qi)
                int ek = array.get(mK, qi)
                float dl = (na(cp) ? na : math.abs(cn) - math.abs(cp))
                [tTxt, tCol] = f_trend(cn, cp, cpm)
                string ld = ek == 0 ? "Simultaneous" : f_leader(ia, ib, ek) + " (" + str.tostring(math.abs(ek)) + "b)"
                color bg = nr % 2 == 0 ? cRowA : cRowB
                f_row(tblScan, nr, array.from(str.tostring(i + 1), f_nm(ia), f_nm(ib), "", "", f_c2(dl), tTxt, ld), array.from(cGrey, cText, cText, cText, cText, f_clr(dl), tCol, cText), bg, false, szScan)
                f_corrCell(tblScan, 3, nr, cn, bg, szScan)
                f_corrCell(tblScan, 4, nr, cp, bg, szScan)
                nr += 1

    //------------------------------------------------
    // PAIR RESOLVE
    //------------------------------------------------
    int idxA = math.min(studyA, nAssets) - 1
    int idxB = math.min(studyB, nAssets) - 1
    string pairSrc = "Manual slots"
    if studyRank > 0
        if matchedN >= studyRank
            int qs = array.get(srt, studyRank - 1)
            idxA := array.get(mA, qs)
            idxB := array.get(mB, qs)
            pairSrc := "Scanner rank #" + str.tostring(studyRank)
        else
            pairSrc := "Rank #" + str.tostring(studyRank) + " nahi mila (matched " + str.tostring(matchedN) + ") -> manual slots"

    //------------------------------------------------
    // PAIR STUDY TABLE
    //------------------------------------------------
    if showPair
        tblPair := table.new(posPair, 8, 80, border_color=cBorder, border_width=1, frame_color=cBorder, frame_width=1)
        int pr = 0
        f_title(tblPair, pr, 8, "PAIR STUDY  |  " + f_nm(idxA) + " vs " + f_nm(idxB) + "  |  " + timeframe.period, szPair)
        pr += 1

        if idxA == idxB
            f_info(tblPair, pr, 8, "Warning", "Asset A aur B alag chunein", cRed, szPair)
            pr += 1
        else
            AssetData pa = array.get(store, idxA)
            AssetData pbd = array.get(store, idxB)
            array<float> ra = pa.rt
            array<float> rb = pbd.rt
            array<int> winArr = array.from(win1, win2, win3, win4)

            int maxW = 0
            for k = 0 to nWin - 1
                maxW := math.max(maxW, array.get(winArr, k))
            int needBars = maxW + 3 * snapStep + maxLag

            // verdict (shortest vs longest window, abhi ki correlation)
            int wS = array.get(winArr, 0)
            int wL = array.get(winArr, nWin - 1)
            [cS, bS, nS, gS] = f_stats(ra, rb, m - wS, wS, 0, minValidPct)
            [cL, bL, nL, gL] = f_stats(ra, rb, m - wL, wL, 0, minValidPct)
            string verdict = "Data kam"
            color verdictCol = cYellow
            if not na(cS) and not na(cL)
                float aS = math.abs(cS)
                float aL = math.abs(cL)
                if aS >= strongThr and aL >= strongThr
                    verdict := (cS < 0 and cL < 0 ? "Strong INVERSE link (short + long)" : "Strong link (short + long)")
                    verdictCol := cGreen
                else if aS < decoupleThr and aL >= strongThr
                    verdict := "Recent breakdown: long-term link tha, short-term toot gaya"
                    verdictCol := cRed
                else if aS >= strongThr and aL < strongThr
                    verdict := "Naya / tightening link: short-term strong, long-term weak"
                    verdictCol := cGreen
                else if aS < decoupleThr and aL < decoupleThr
                    verdict := "Koi meaningful relation nahi"
                    verdictCol := cRed
                else
                    verdict := "Moderate / mixed relation"
                    verdictCol := cYellow

            f_info(tblPair, pr, 8, "Chart First Candle", f_date(chartFirstTime), cYellow, szPair)
            pr += 1
            f_info(tblPair, pr, 8, "Selected From", f_date(fromDate), cText, szPair)
            pr += 1
            f_info(tblPair, pr, 8, "Selected To", f_date(toDate), cText, szPair)
            pr += 1
            f_info(tblPair, pr, 8, "Asset A", "Slot " + str.tostring(idxA + 1) + "  |  " + array.get(symAll, idxA), cText, szPair)
            pr += 1
            f_info(tblPair, pr, 8, "Asset B", "Slot " + str.tostring(idxB + 1) + "  |  " + array.get(symAll, idxB), cText, szPair)
            pr += 1
            f_info(tblPair, pr, 8, "Pair Source", pairSrc, cGrey, szPair)
            pr += 1
            f_info(tblPair, pr, 8, "Bars in Range", str.tostring(m + 1), cText, szPair)
            pr += 1
            f_info(tblPair, pr, 8, "Verdict", verdict, verdictCol, szPair)
            pr += 1
            if m < needBars
                f_info(tblPair, pr, 8, "Warning", "Poore snapshots ke liye " + str.tostring(needBars) + " bars chahiye (abhi " + str.tostring(m) + "); kuch cells n/a", cYellow, szPair)
                pr += 1

            //--------------------------------------------
            // A. ROLLING CORRELATION PHASES
            //--------------------------------------------
            if secPhases
                f_sec(tblPair, pr, 8, "A. ROLLING CORRELATION PHASES  (corr, Now vs pichle snapshots)", szPair)
                pr += 1
                f_row(tblPair, pr, array.from("Window", "Now", "-" + str.tostring(snapStep) + "b", "-" + str.tostring(2 * snapStep) + "b", "-" + str.tostring(3 * snapStep) + "b", "Δ|Corr|", "Agree %", "Status"), array.from(cText, cText, cText, cText, cText, cText, cText, cText), cSecBg, true, szPair)
                pr += 1
                for k = 0 to nWin - 1
                    int w = array.get(winArr, k)
                    [c0, b0, n0, g0] = f_stats(ra, rb, m - w, w, 0, minValidPct)
                    [c1, b1, n1, g1] = f_stats(ra, rb, m - snapStep - w, w, 0, minValidPct)
                    [c2, b2, n2, g2] = f_stats(ra, rb, m - 2 * snapStep - w, w, 0, minValidPct)
                    [c3, b3, n3, g3] = f_stats(ra, rb, m - 3 * snapStep - w, w, 0, minValidPct)
                    float pastMax = na
                    if not na(c1)
                        pastMax := math.abs(c1)
                    if not na(c2)
                        pastMax := na(pastMax) ? math.abs(c2) : math.max(pastMax, math.abs(c2))
                    if not na(c3)
                        pastMax := na(pastMax) ? math.abs(c3) : math.max(pastMax, math.abs(c3))
                    float dl = (na(c0) or na(c1)) ? na : math.abs(c0) - math.abs(c1)
                    [tTxt, tCol] = f_trend(c0, c1, pastMax)
                    color bg = pr % 2 == 0 ? cRowA : cRowB
                    f_row(tblPair, pr, array.from(str.tostring(w) + " bars", "", "", "", "", f_c2(dl), na(g0) ? "-" : str.tostring(g0, "0") + "%", f_strength(c0) + " | " + tTxt), array.from(cText, cText, cText, cText, cText, f_clr(dl), cGrey, tCol), bg, false, szPair)
                    f_corrCell(tblPair, 1, pr, c0, bg, szPair)
                    f_corrCell(tblPair, 2, pr, c1, bg, szPair)
                    f_corrCell(tblPair, 3, pr, c2, bg, szPair)
                    f_corrCell(tblPair, 4, pr, c3, bg, szPair)
                    pr += 1

            //--------------------------------------------
            // B. LEAD-LAG & SPEED
            //--------------------------------------------
            if secLead
                f_sec(tblPair, pr, 8, "B. LEAD-LAG & SPEED  (Leader → Follower)", szPair)
                pr += 1
                f_row(tblPair, pr, array.from("Window", "Lag (bars)", "Corr @Lag", "Corr @0", "Edge", "Leader → Follower", "Lag Time", "Beta"), array.from(cText, cText, cText, cText, cText, cText, cText, cText), cSecBg, true, szPair)
                pr += 1
                for k = 0 to nWin - 1
                    int w = array.get(winArr, k)
                    [bk, bc, cz, bb, bz] = f_best(ra, rb, m, 0, w, maxLag, minValidPct)
                    int ek = f_effK(bk, bc, cz)
                    float shownC = ek == 0 ? cz : bc
                    float shownB = ek == 0 ? bz : bb
                    float edge = (na(bc) or na(cz)) ? na : math.abs(bc) - math.abs(cz)
                    color bg = pr % 2 == 0 ? cRowA : cRowB
                    f_row(tblPair, pr, array.from(str.tostring(w) + " bars", na(bc) ? "-" : (ek > 0 ? "+" : "") + str.tostring(ek), "", "", f_c2(edge), na(bc) ? "n/a" : f_leader(idxA, idxB, ek), na(bc) ? "-" : f_lagTime(ek), na(shownB) ? "-" : str.tostring(shownB, "0.00")), array.from(cText, cText, cText, cText, cGrey, cText, cText, cText), bg, false, szPair)
                    f_corrCell(tblPair, 2, pr, shownC, bg, szPair)
                    f_corrCell(tblPair, 3, pr, cz, bg, szPair)
                    pr += 1
                f_info(tblPair, pr, 8, "Beta kya hai", "Follower ka move per 1% leader move (lag par). Edge = lag corr - same-bar corr", cGrey, szPair)
                pr += 1

            //--------------------------------------------
            // C. LAG PROFILE (primary window)
            //--------------------------------------------
            if secProfile
                int pw = array.get(winArr, math.min(leadPrimary, nWin) - 1)
                f_sec(tblPair, pr, 8, "C. LAG PROFILE  (window " + str.tostring(pw) + " bars)", szPair)
                pr += 1
                f_row(tblPair, pr, array.from("Lag (bars)", "Direction", "Corr", "Strength", "", "", "", ""), array.from(cText, cText, cText, cText, cText, cText, cText, cText), cSecBg, true, szPair)
                table.merge_cells(tblPair, 3, pr, 7, pr)
                pr += 1
                [pk, pc, pz, pbb, pbz] = f_best(ra, rb, m, 0, pw, maxLag, minValidPct)
                for k = -maxLag to maxLag
                    [lc, lb, ln, lg] = f_lagStats(ra, rb, m, 0, pw, k, minValidPct)
                    color bg = pr % 2 == 0 ? cRowA : cRowB
                    bool isBestRow = k == pk and not na(pc)
                    int barN = na(lc) ? 0 : int(math.round(math.abs(lc) * 20))
                    string dirTxt = f_leader(idxA, idxB, k)
                    if k == 0
                        dirTxt := "Same bar"
                    f_cell(tblPair, 0, pr, (isBestRow ? "★ " : "") + (k > 0 ? "+" : "") + str.tostring(k), cText, isBestRow ? cBestBg : bg, text.align_left, szPair, false)
                    f_cell(tblPair, 1, pr, dirTxt, cText, bg, text.align_right, szPair, false)
                    f_corrCell(tblPair, 2, pr, lc, bg, szPair)
                    f_cell(tblPair, 3, pr, na(lc) ? "-" : str.repeat("█", barN), f_clr(lc), bg, text.align_left, szPair, false)
                    for cc = 4 to 7
                        f_cell(tblPair, cc, pr, "", cText, bg, text.align_left, szPair, false)
                    table.merge_cells(tblPair, 3, pr, 7, pr)
                    pr += 1

            //--------------------------------------------
            // D. PERFORMANCE & RISK
            //--------------------------------------------
            if secPerf
                f_sec(tblPair, pr, 8, "D. PERFORMANCE & RISK  (same window, lag 0)", szPair)
                pr += 1
                f_row(tblPair, pr, array.from("Window", f_nm(idxA) + " Ret %", f_nm(idxB) + " Ret %", "Spread A-B", "Beta (B on A)", "R²", "Vol A %/bar", "Vol B %/bar"), array.from(cText, cText, cText, cText, cText, cText, cText, cText), cSecBg, true, szPair)
                pr += 1
                for k = 0 to nWin - 1
                    int w = array.get(winArr, k)
                    float retA = f_sumRet(ra, m, 0, w)
                    float retB = f_sumRet(rb, m, 0, w)
                    float spr = (na(retA) or na(retB)) ? na : retA - retB
                    [cc0, bt0, nn0, gg0] = f_stats(ra, rb, m - w, w, 0, minValidPct)
                    float r2 = na(cc0) ? na : cc0 * cc0
                    float volA = f_stdev(ra, m, 0, w)
                    float volB = f_stdev(rb, m, 0, w)
                    color bg = pr % 2 == 0 ? cRowA : cRowB
                    f_row(tblPair, pr, array.from(str.tostring(w) + " bars", f_p2(retA), f_p2(retB), f_p2(spr), na(bt0) ? "-" : str.tostring(bt0, "0.00"), na(r2) ? "-" : str.tostring(r2, "0.00"), na(volA) ? "-" : str.tostring(volA, "0.00"), na(volB) ? "-" : str.tostring(volB, "0.00")), array.from(cText, f_clr(retA), f_clr(retB), f_clr(spr), cText, cGrey, cGrey, cGrey), bg, false, szPair)
                    pr += 1

//====================================================
// SELECTED DATE RANGE VERTICAL LINES
//====================================================
var line selectedFromLine = na
var line selectedToLine = na

if barstate.islast

    if not na(selectedFromLine)
        line.delete(selectedFromLine)
        selectedFromLine := na

    if not na(selectedToLine)
        line.delete(selectedToLine)
        selectedToLine := na

    if showRangeVerticalLines

        float lineTop = high == low ? high + syminfo.mintick : high

        if not na(fromBarIdx)
            selectedFromLine := line.new(x1=fromBarIdx, y1=low, x2=fromBarIdx, y2=lineTop, xloc=xloc.bar_index, extend=extend.both, color=color.lime, style=line.style_dashed, width=1)

        selectedToLine := line.new(x1=toDate, y1=low, x2=toDate, y2=lineTop, xloc=xloc.bar_time, extend=extend.both, color=color.red, style=line.style_dashed, width=1)
