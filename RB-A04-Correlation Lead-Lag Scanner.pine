leadEdge = input.float(0.05, "Lead Edge (min gain over lag 0)", minval=0.0, maxval=0.5, step=0.01, group=g8, display=display.none,
     tooltip="Kisi asset ko Leader tabhi maana jayega jab lag par correlation, same-bar (lag 0) correlation se kam se kam itni zyada ho. Warna 'Simultaneous' (dono saath chalte hain).")
leadPrimary = input.int(2, "Primary Window (1-4)", minval=1, maxval=4, group=g8, display=display.none,
