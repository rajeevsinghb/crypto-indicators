     tooltip="0 = upar ke Asset A / B slots use honge.\n1, 2, 3... = Scanner table ke us # (rank) wali pair ka seedha deep study. Scanner me pair dekhi, uska # yahan daalein - A/B manually dhoondhne ki zaroorat nahi.")
secPhases = input.bool(true, "Pair Section A: Rolling Correlation Phases", group=g1, display=display.none,
