//====================================================
strongThr = input.float(0.60, "Strong Correlation Threshold", minval=0.1, maxval=1.0, step=0.05, group=g7, display=display.none,
     tooltip="|Correlation| is value ya upar ho to relation 'Strong' maana jayega.")
decoupleThr = input.float(0.30, "Decoupled Below |Corr|", minval=0.0, maxval=0.9, step=0.05, group=g7, display=display.none,
     tooltip="|Correlation| is value se neeche chali jaye (jabki pehle isse upar thi) to relation 'Decoupled' (khatam) maana jayega. Isse neeche 'Weak' bhi maana jata hai.")
trendTol = input.float(0.10, "Trend Tolerance (change in |Corr|)", minval=0.01, maxval=0.5, step=0.01, group=g7, display=display.none,
     tooltip="|Correlation| me itna ya zyada badlav ho to hi 'Strengthening' ya 'Weakening' kaha jayega, warna 'Stable'.")

//====================================================
