//====================================================
matSizeStr = input.string("Tiny", "Matrix Table Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=g7, display=display.none,
     tooltip="Matrix ke text ka size. Columns zyada (e.g. Hour x Date) ho to Tiny rakhein.")
matPosStr = input.string("Top Right", "Matrix Table Position", options=["Top Right", "Top Left", "Top Center", "Middle Right", "Middle Left", "Bottom Right", "Bottom Left", "Bottom Center"], group=g7, display=display.none,
     tooltip="Matrix table chart par kahan dikhe.")
matHeatmap = input.bool(true, "Heatmap Shading", group=g7, display=display.none,
     tooltip="ON: dabbe ka background value ke hisaab se green (positive) ya red (negative) shade hota hai; jitna gehra, utna bada move. OFF: sirf text ka color.")

//====================================================
// 08. OVERALL STATS TABLE
//====================================================
ovrSizeStr = input.string("Small", "Overall Table Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=g8, display=display.none,
     tooltip="Overall stats table ke text ka size.")
ovrPosStr = input.string("Top Right", "Overall Table Position", options=["Top Right", "Top Left", "Top Center", "Middle Right", "Middle Left", "Bottom Right", "Bottom Left", "Bottom Center"], group=g8, display=display.none,
     tooltip="Overall stats table chart par kahan dikhe.")

//====================================================
// 09. CHART VERIFY TOOLS
//====================================================
showFilterBg = input.bool(false, "Highlight Filtered Candles on Chart", group=g9, display=display.none,
     tooltip="ON: jo candles saare filters pass karti hain unka background peela hoga. Table ke count ko chart se match karne ke liye.")
showPctLabels = input.bool(false, "Show Candle % Labels on Chart", group=g9, display=display.none,
     tooltip="ON: filtered candles par unka exact % label dikhega (last 500 labels tak). Verify karne ke liye.")

//====================================================
// PRESET -> ROWS / COLUMNS
//====================================================
string rowDimStr = switch presetStr
    "Date x Month"    => "Day of Month"
    "Hour x Weekday"  => "Hour"
    "Hour x Date"     => "Hour"
    "Weekday x Month" => "Weekday"
    "Month only"      => "Month"
    "Hour only"       => "Hour"
    => customRowDim

string colDimStr = switch presetStr
    "Date x Month"    => "Month"
    "Hour x Weekday"  => "Weekday"
    "Hour x Date"     => "Day of Month"
    "Weekday x Month" => "Month"
    "Month only"      => "None"
    "Hour only"       => "None"
    => customColDim

//====================================================
// TABLE STYLE  (RB-A02 ka dark navy theme)
//====================================================
color cTitleBg = color.rgb(24, 38, 71)
color cSecBg   = color.rgb(42, 52, 84)
color cRowA    = color.rgb(22, 27, 40)
color cRowB    = color.rgb(31, 37, 54)
color cBorder  = color.rgb(58, 64, 84)
color cText    = color.rgb(235, 238, 245)
color cGrey    = color.rgb(165, 171, 190)
color cGreen   = color.rgb(0, 200, 110)
color cRed     = color.rgb(240, 62, 72)
color cYellow  = color.rgb(255, 214, 10)
color cShadeG  = color.rgb(0, 120, 75)
color cShadeR  = color.rgb(155, 36, 46)
color cBestBg  = color.rgb(20, 70, 50)
color cWorstBg = color.rgb(82, 28, 36)

//====================================================
// HELPER FUNCTIONS
//====================================================
f_pos(string s) =>
    switch s
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Middle Right"  => position.middle_right
        "Middle Left"   => position.middle_left
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        => position.top_right

f_size(string s) =>
    switch s
        "Tiny"  => size.tiny
        "Small" => size.small
        "Large" => size.large
        "Huge"  => size.huge
        => size.normal

string posSum = f_pos(sumPosStr)
string posMat = f_pos(matPosStr)
string posOvr = f_pos(ovrPosStr)
string szSum  = f_size(sumSizeStr)
string szMat  = f_size(matSizeStr)
string szOvr  = f_size(ovrSizeStr)

f_pct(float v) =>
    na(v) ? "-" : str.tostring(v, "0.00") + "%"

f_spct(float v) =>
    na(v) ? "-" : (v > 0 ? "+" : "") + str.tostring(v, "0.00") + "%"

f_volume(float value) =>
    string result = "N/A"
    if not na(value)
        float a = math.abs(value)
        if a >= 1000000000000.0
            result := str.tostring(value / 1000000000000.0, "0.00") + "T"
        else if a >= 1000000000.0
            result := str.tostring(value / 1000000000.0, "0.00") + "B"
        else if a >= 1000000.0
            result := str.tostring(value / 1000000.0, "0.00") + "M"
        else if a >= 1000.0
            result := str.tostring(value / 1000.0, "0.00") + "K"
        else
            result := str.tostring(value, "0.00")
    result

f_date(int t) =>
    na(t) ? "N/A" : str.format_time(t, "yyyy-MM-dd HH:mm", displayTz)

f_pad2(int i) =>
    (i < 10 ? "0" : "") + str.tostring(i)

f_percentile(array<float> source, float percentile) =>
    float result = na
    int n = array.size(source)
    if n > 0
        array<float> temp = array.copy(source)
        array.sort(temp, order.ascending)
        if n == 1
            result := array.get(temp, 0)
        else
            float position = (n - 1) * percentile
            int lowerIndex = int(math.floor(position))
            int upperIndex = int(math.ceil(position))
            float lowerValue = array.get(temp, lowerIndex)
            float upperValue = array.get(temp, upperIndex)
            result := lowerIndex == upperIndex ? lowerValue : lowerValue + (upperValue - lowerValue) * (position - lowerIndex)
    result

// a <= b : normal range | a > b : wrap (e.g. 22 se 3)
f_inSpan(int v, int a, int b) =>
    a <= b ? (v >= a and v <= b) : (v >= a or v <= b)

//---------------- dimension helpers ----------------
var array<string> wdNames  = array.from("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
var array<string> monNames = array.from("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")

f_dimSize(string d) =>
    switch d
        "Hour"         => 24
        "Weekday"      => 7
        "Day of Month" => 31
        "Month"        => 12
        => 1

f_dimIdx(string d, int h, int w, int dm, int mo) =>
    switch d
        "Hour"         => h
        "Weekday"      => w
        "Day of Month" => dm - 1
        "Month"        => mo - 1
        => 0

f_dimLabel(string d, int i) =>
    string s = ""
    if d == "Hour"
        s := f_pad2(i) + ":00"
    else if d == "Weekday"
        s := array.get(wdNames, i)
    else if d == "Day of Month"
        s := str.tostring(i + 1)
    else if d == "Month"
        s := array.get(monNames, i)
    s

f_dimHead(string d) =>
    switch d
        "Hour"         => "HOUR"
        "Weekday"      => "WEEKDAY"
        "Day of Month" => "DATE"
        "Month"        => "MONTH"
        => ""

// Matrix cell value (metric)
f_metric(string m, int up, int dn, int fl, float sU, float sD) =>
    float v = na
    int n = up + dn + fl
    if n > 0
        if m == "Net % (sum)"
            v := sU + sD
        else if m == "Avg % per candle"
            v := (sU + sD) / n
        else if m == "Win Rate %"
            v := (up + dn) > 0 ? up * 100.0 / (up + dn) : na
        else if m == "Sum Up %"
            v := sU
        else
            v := sD
    v

f_clr(float v, float mid) =>
    na(v) ? cGrey : v > mid ? cGreen : v < mid ? cRed : cText

f_shade(float cv, float maxAbs, color base) =>
    color out = base
    if not na(cv) and maxAbs > 0
        float t = math.min(math.abs(cv) / maxAbs, 1.0)
        out := cv >= 0 ? color.from_gradient(t, 0.0, 1.0, base, cShadeG) : color.from_gradient(t, 0.0, 1.0, base, cShadeR)
    out

//---------------- table helpers ----------------
f_cell(table t, int c, int r, string txt, color tc, color bg, string ha, string sz, bool bold) =>
    table.cell(t, c, r, txt, text_color=tc, bgcolor=bg, text_halign=ha, text_size=sz, text_formatting=bold ? text.format_bold : text.format_none)

f_title(table t, int row, int nCols, string txt, string sz) =>
    f_cell(t, 0, row, txt, cText, cTitleBg, text.align_center, sz, true)
    for c = 1 to nCols - 1
        f_cell(t, c, row, "", cText, cTitleBg, text.align_center, sz, false)
    table.merge_cells(t, 0, row, nCols - 1, row)

f_info(table t, int row, int nCols, string lbl, string val, color vc, string sz) =>
    color bg = row % 2 == 0 ? cRowA : cRowB
    f_cell(t, 0, row, lbl, cText, bg, text.align_left, sz, false)
    f_cell(t, 1, row, val, vc, bg, text.align_right, sz, false)
    for c = 2 to nCols - 1
        f_cell(t, c, row, "", cText, bg, text.align_right, sz, false)
    table.merge_cells(t, 1, row, nCols - 1, row)

f_row(table t, int row, array<string> txt, array<color> tcs, color bg, bool isHead, string sz) =>
    for c = 0 to array.size(txt) - 1
        string ha = c == 0 ? text.align_left : (isHead ? text.align_center : text.align_right)
        f_cell(t, c, row, array.get(txt, c), array.get(tcs, c), bg, ha, sz, isHead)

//====================================================
// CHART FIRST CANDLE / RANGE
//====================================================
var int chartFirstTime = na
if na(chartFirstTime)
    chartFirstTime := time

int fromDate = useChartFirstAsFrom ? chartFirstTime : manualFromDate
bool inRange = time >= fromDate and time <= toDate

var int fromBarIdx = na
if inRange and na(fromBarIdx)
    fromBarIdx := bar_index

//====================================================
// PER-CANDLE VALUES + FILTERS
//====================================================
int hr     = hour(time, displayTz)
int wdIdx  = (dayofweek(time, displayTz) + 5) % 7     // 0 = Mon ... 6 = Sun
int domV   = dayofmonth(time, displayTz)
int monV   = month(time, displayTz)

float pctVal = na
if pctBasis == "Close vs Open"
    pctVal := open != 0 ? (close - open) / math.abs(open) * 100.0 : na
else if pctBasis == "Close vs Previous Close"
    pctVal := (not na(close[1]) and close[1] != 0) ? (close - close[1]) / math.abs(close[1]) * 100.0 : na
else if pctBasis == "High vs Open (Upside)"
    pctVal := open != 0 ? (high - open) / math.abs(open) * 100.0 : na
else if pctBasis == "Low vs Open (Downside)"
    pctVal := open != 0 ? (low - open) / math.abs(open) * 100.0 : na
else
    pctVal := open != 0 ? (high - low) / math.abs(open) * 100.0 : na

bool wdPass = switch wdIdx
    0 => fMon
    1 => fTue
    2 => fWed
    3 => fThu
    4 => fFri
    5 => fSat
    => fSun

bool passFilter = inRange and not na(pctVal) and f_inSpan(hr, hourFrom, hourTo) and f_inSpan(monV, monthFrom, monthTo) and f_inSpan(domV, domFrom, domTo) and wdPass
bool processBar = passFilter and barstate.isconfirmed

int rIdx = f_dimIdx(rowDimStr, hr, wdIdx, domV, monV)
int cIdx = f_dimIdx(colDimStr, hr, wdIdx, domV, monV)

bool dirBasis  = pctBasis == "Close vs Open" or pctBasis == "Close vs Previous Close"
bool usesHour  = rowDimStr == "Hour" or colDimStr == "Hour" or hourFrom > 0 or hourTo < 23
bool hourWarn  = usesHour and not timeframe.isintraday
bool subHourTf = timeframe.isintraday and timeframe.in_seconds() < 3600

//====================================================
// STATE
//====================================================
int rowN = f_dimSize(rowDimStr)
int colN = f_dimSize(colDimStr)
int cellN = rowN * colN

var array<int>   arrUp = array.new_int(cellN, 0)
var array<int>   arrDn = array.new_int(cellN, 0)
var array<int>   arrFl = array.new_int(cellN, 0)
var array<float> arrSU = array.new_float(cellN, 0.0)
var array<float> arrSD = array.new_float(cellN, 0.0)

var int totalCandles = 0
var int greenCount = 0
var int redCount = 0
var int flatCount = 0
var float greenVolSum = 0.0
var float redVolSum = 0.0
var float totalVolSum = 0.0
var int greenVolCnt = 0
var int redVolCnt = 0
var int totalVolCnt = 0
var array<float> bodyVals  = array.new_float()
var array<float> rangeVals = array.new_float()
var array<float> volVals   = array.new_float()

//====================================================
// PROCESS FILTERED CANDLE
//====================================================
if processBar
    totalCandles += 1
    bool isFlat = pctVal == 0 or math.abs(pctVal) < minAbsPct

    if isFlat
        flatCount += 1
    else if pctVal > 0
        greenCount += 1
        if not na(volume)
            greenVolSum += volume
            greenVolCnt += 1
    else
        redCount += 1
        if not na(volume)
            redVolSum += volume
            redVolCnt += 1

    if not na(volume)
        totalVolSum += volume
        totalVolCnt += 1
        array.push(volVals, volume)

    if open != 0
        array.push(bodyVals, math.abs(close - open) / math.abs(open) * 100.0)
        array.push(rangeVals, (high - low) / math.abs(open) * 100.0)

    if rIdx >= 0 and cIdx >= 0 and rIdx < rowN and cIdx < colN
        int k = rIdx * colN + cIdx
        if isFlat
            array.set(arrFl, k, array.get(arrFl, k) + 1)
        else if pctVal > 0
            array.set(arrUp, k, array.get(arrUp, k) + 1)
            array.set(arrSU, k, array.get(arrSU, k) + pctVal)
        else
            array.set(arrDn, k, array.get(arrDn, k) + 1)
            array.set(arrSD, k, array.get(arrSD, k) + pctVal)

    if showPctLabels
        label.new(bar_index, pctVal >= 0 ? high : low, f_spct(pctVal), style=pctVal >= 0 ? label.style_label_down : label.style_label_up, textcolor=color.white, color=pctVal >= 0 ? color.green : color.red, size=size.small)

bgcolor(showFilterBg and passFilter ? color.new(color.yellow, 88) : na)

//====================================================
// TABLES  (sirf last bar par)
//====================================================
var table tblSum = na
var table tblMat = na
var table tblOvr = na

if barstate.islast
    if not na(tblSum)
        table.delete(tblSum)
        tblSum := na
    if not na(tblMat)
        table.delete(tblMat)
        tblMat := na
    if not na(tblOvr)
        table.delete(tblOvr)
        tblOvr := na

    //------------------------------------------------
    // ROW / COLUMN MARGINALS
    //------------------------------------------------
    array<int>   rU  = array.new_int(rowN, 0)
    array<int>   rD  = array.new_int(rowN, 0)
    array<int>   rF  = array.new_int(rowN, 0)
    array<float> rSU = array.new_float(rowN, 0.0)
    array<float> rSD = array.new_float(rowN, 0.0)
    array<int>   cU  = array.new_int(colN, 0)
    array<int>   cD  = array.new_int(colN, 0)
    array<int>   cF  = array.new_int(colN, 0)
    array<float> cSU = array.new_float(colN, 0.0)
    array<float> cSD = array.new_float(colN, 0.0)
    int tU = 0
    int tD = 0
    int tF = 0
    float tSU = 0.0
    float tSD = 0.0

    for r = 0 to rowN - 1
        for c = 0 to colN - 1
            int k = r * colN + c
            int u = array.get(arrUp, k)
            int d = array.get(arrDn, k)
            int f = array.get(arrFl, k)
            float su = array.get(arrSU, k)
            float sd = array.get(arrSD, k)
            array.set(rU, r, array.get(rU, r) + u)
            array.set(rD, r, array.get(rD, r) + d)
            array.set(rF, r, array.get(rF, r) + f)
            array.set(rSU, r, array.get(rSU, r) + su)
            array.set(rSD, r, array.get(rSD, r) + sd)
            array.set(cU, c, array.get(cU, c) + u)
            array.set(cD, c, array.get(cD, c) + d)
            array.set(cF, c, array.get(cF, c) + f)
            array.set(cSU, c, array.get(cSU, c) + su)
            array.set(cSD, c, array.get(cSD, c) + sd)
            tU += u
            tD += d
            tF += f
            tSU += su
            tSD += sd

    //------------------------------------------------
    // SORT ORDER + BEST / WORST
    //------------------------------------------------
    array<float> keys = array.new_float(rowN, 0.0)
    int bestR = -1
    int worstR = -1
    float bestV = na
    float worstV = na

    for r = 0 to rowN - 1
        int n = array.get(rU, r) + array.get(rD, r) + array.get(rF, r)
        float net = array.get(rSU, r) + array.get(rSD, r)
        int dirN = array.get(rU, r) + array.get(rD, r)
        float winr = dirN > 0 ? array.get(rU, r) * 100.0 / dirN : na
        float avg = n > 0 ? net / n : na
        float key = na
        if sortStr == "Net % (high to low)"
            key := n > 0 ? net : na
        else if sortStr == "Win Rate % (high to low)"
            key := winr
        else if sortStr == "Avg % (high to low)"
            key := avg
        array.set(keys, r, na(key) ? -1.0e18 : key)

        if n >= minSamples
            if bestR == -1 or net > bestV
                bestR := r
                bestV := net
            if worstR == -1 or net < worstV
                worstR := r
                worstV := net

    array<int> ord = array.new_int(0)
    if sortStr == "Natural order"
        for r = 0 to rowN - 1
            array.push(ord, r)
    else
        ord := array.sort_indices(keys, order.descending)

    //------------------------------------------------
    // VISIBLE ROWS + PAGING
    //------------------------------------------------
    array<int> vis = array.new_int(0)
    for i = 0 to rowN - 1
        int rr = array.get(ord, i)
        int nn = array.get(rU, rr) + array.get(rD, rr) + array.get(rF, rr)
        if nn > 0 or not hideEmptyRows
            array.push(vis, rr)
    int visN = array.size(vis)
    int perPage = rowsPerPage <= 0 ? math.max(visN, 1) : rowsPerPage
    int pages = math.max(1, int(math.ceil(visN * 1.0 / perPage)))
    int pg = math.min(math.max(pageNo, 1), pages)
    int startI = (pg - 1) * perPage
    int endI = math.max(math.min(startI + perPage, visN) - 1, 0)
    string pageTxt = "Page " + str.tostring(pg) + " / " + str.tostring(pages)

    //------------------------------------------------
    // FILTER TEXT
    //------------------------------------------------
    array<bool> wdOnArr = array.from(fMon, fTue, fWed, fThu, fFri, fSat, fSun)
    string wdTxt = ""
    int wdCnt = 0
    for i = 0 to 6
        if array.get(wdOnArr, i)
            wdCnt += 1
            wdTxt += (wdTxt == "" ? "" : ",") + array.get(wdNames, i)
    if wdCnt == 7
        wdTxt := "All days"
    if wdCnt == 0
        wdTxt := "No day"

    string hrTxt = "Hr " + f_pad2(hourFrom) + " - " + f_pad2(hourTo) + "  |  " + wdTxt
    string dtTxt = "Month " + str.tostring(monthFrom) + "-" + str.tostring(monthTo) + "  |  Date " + str.tostring(domFrom) + "-" + str.tostring(domTo) + (minAbsPct > 0 ? "  |  min " + str.tostring(minAbsPct, "0.00") + "%" : "")

    //------------------------------------------------
    // SUMMARY TABLE
    //------------------------------------------------
    if showSummary
        tblSum := table.new(posSum, 8, 20 + rowN, border_color=cBorder, border_width=1, frame_color=cBorder, frame_width=1)
        int nr = 0
        f_title(tblSum, nr, 8, "TIME BEHAVIOUR  |  " + syminfo.ticker + "  |  " + timeframe.period, szSum)
        nr += 1
        f_info(tblSum, nr, 8, "Chart First Candle", f_date(chartFirstTime), cYellow, szSum)
        nr += 1
        f_info(tblSum, nr, 8, "Selected From", f_date(fromDate), cText, szSum)
        nr += 1
        f_info(tblSum, nr, 8, "Selected To", f_date(toDate), cText, szSum)
        nr += 1
        f_info(tblSum, nr, 8, "Preset", presetStr + "  |  Rows: " + rowDimStr, cText, szSum)
        nr += 1
        f_info(tblSum, nr, 8, "Filter 1", hrTxt, cText, szSum)
        nr += 1
        f_info(tblSum, nr, 8, "Filter 2", dtTxt, cText, szSum)
        nr += 1
        f_info(tblSum, nr, 8, "Candle % Basis", pctBasis, cText, szSum)
        nr += 1
        if not dirBasis
            f_info(tblSum, nr, 8, "Note", "Is basis me Win % meaningful nahi; Avg % dekhein", cYellow, szSum)
            nr += 1
        if pages > 1
            f_info(tblSum, nr, 8, "Page", pageTxt + "  (Settings me Page No. badlein)", cYellow, szSum)
            nr += 1
        if hourWarn
            f_info(tblSum, nr, 8, "Warning", "Hour analysis ke liye intraday TF (1H) lagayein", cRed, szSum)
            nr += 1
        else if subHourTf and usesHour
            f_info(tblSum, nr, 8, "Note", "TF 1H se chhota: hour ki candles combine hongi (1H best)", cYellow, szSum)
            nr += 1

        f_row(tblSum, nr, array.from(f_dimHead(rowDimStr), "Up #", "Down #", "Win %", "Up % (sum)", "Down % (sum)", "Net %", "Avg %"), array.from(cText, cText, cText, cText, cText, cText, cText, cText), cSecBg, true, szSum)
        nr += 1

        for i = startI to endI
            int r = visN > 0 ? array.get(vis, i) : 0
            int u = array.get(rU, r)
            int d = array.get(rD, r)
            int f = array.get(rF, r)
            int n = u + d + f
            if n > 0 or not hideEmptyRows
                float net = array.get(rSU, r) + array.get(rSD, r)
                float winr = (u + d) > 0 ? u * 100.0 / (u + d) : na
                float avg = n > 0 ? net / n : na
                bool isBest = highlightBW and r == bestR
                bool isWorst = highlightBW and r == worstR
                color bg = isBest ? cBestBg : isWorst ? cWorstBg : (nr % 2 == 0 ? cRowA : cRowB)
                string lbl = (isBest ? "★ " : isWorst ? "▼ " : "") + f_dimLabel(rowDimStr, r)
                f_row(tblSum, nr, array.from(lbl, str.tostring(u), str.tostring(d), f_pct(winr), f_spct(array.get(rSU, r)), f_spct(array.get(rSD, r)), n > 0 ? f_spct(net) : "-", f_spct(avg)), array.from(cText, cGreen, cRed, f_clr(winr, 50.0), cGreen, cRed, f_clr(n > 0 ? net : na, 0.0), f_clr(avg, 0.0)), bg, false, szSum)
                nr += 1

        int tn = tU + tD + tF
        float tNet = tSU + tSD
        float tWin = (tU + tD) > 0 ? tU * 100.0 / (tU + tD) : na
        float tAvg = tn > 0 ? tNet / tn : na
        f_row(tblSum, nr, array.from("TOTAL", str.tostring(tU), str.tostring(tD), f_pct(tWin), f_spct(tSU), f_spct(tSD), tn > 0 ? f_spct(tNet) : "-", f_spct(tAvg)), array.from(cText, cGreen, cRed, f_clr(tWin, 50.0), cGreen, cRed, f_clr(tn > 0 ? tNet : na, 0.0), f_clr(tAvg, 0.0)), cSecBg, false, szSum)
        nr += 1

        if bestR >= 0
            f_info(tblSum, nr, 8, "Strongest (Net %)", f_dimLabel(rowDimStr, bestR) + "   " + f_spct(bestV), cGreen, szSum)
            nr += 1
        if worstR >= 0
            f_info(tblSum, nr, 8, "Weakest (Net %)", f_dimLabel(rowDimStr, worstR) + "   " + f_spct(worstV), cRed, szSum)
            nr += 1

    //------------------------------------------------
    // MATRIX TABLE  (Columns = None ho to nahi banta)
    //------------------------------------------------
    if showMatrix and colDimStr != "None"
        if colDimStr == rowDimStr
            tblMat := table.new(posMat, 2, 2, border_color=cBorder, border_width=1, frame_color=cBorder, frame_width=1)
            f_title(tblMat, 0, 2, "MATRIX TABLE", szMat)
            f_info(tblMat, 1, 2, "Setting", "Custom Rows aur Columns alag chunein", cRed, szMat)
        else
            int mCols = colN + 2
            tblMat := table.new(posMat, mCols, rowN + 4, border_color=cBorder, border_width=1, frame_color=cBorder, frame_width=1)
            bool isWin = matrixMetric == "Win Rate %"
            float mid = isWin ? 50.0 : 0.0

            // max values for heatmap
            float cellMax = 0.0
            float allMax = 0.0
            for r = 0 to rowN - 1
                for c = 0 to colN - 1
                    int k = r * colN + c
                    float v = f_metric(matrixMetric, array.get(arrUp, k), array.get(arrDn, k), array.get(arrFl, k), array.get(arrSU, k), array.get(arrSD, k))
                    if not na(v)
                        cellMax := math.max(cellMax, math.abs(v - mid))
                float rv = f_metric(matrixMetric, array.get(rU, r), array.get(rD, r), array.get(rF, r), array.get(rSU, r), array.get(rSD, r))
                if not na(rv)
                    allMax := math.max(allMax, math.abs(rv - mid))
            for c = 0 to colN - 1
                float cv0 = f_metric(matrixMetric, array.get(cU, c), array.get(cD, c), array.get(cF, c), array.get(cSU, c), array.get(cSD, c))
                if not na(cv0)
                    allMax := math.max(allMax, math.abs(cv0 - mid))

            int mr = 0
            f_title(tblMat, mr, mCols, "MATRIX  |  " + rowDimStr + " x " + colDimStr + "  |  " + matrixMetric + (pages > 1 ? "  |  " + pageTxt : ""), szMat)
            mr += 1

            f_cell(tblMat, 0, mr, f_dimHead(rowDimStr), cText, cSecBg, text.align_left, szMat, true)
            for c = 0 to colN - 1
                f_cell(tblMat, c + 1, mr, f_dimLabel(colDimStr, c), cText, cSecBg, text.align_center, szMat, true)
            f_cell(tblMat, colN + 1, mr, "ALL", cYellow, cSecBg, text.align_center, szMat, true)
            mr += 1

            for i = startI to endI
                int r = visN > 0 ? array.get(vis, i) : 0
                int rn = array.get(rU, r) + array.get(rD, r) + array.get(rF, r)
                if rn > 0 or not hideEmptyRows
                    color rowBg = mr % 2 == 0 ? cRowA : cRowB
                    f_cell(tblMat, 0, mr, f_dimLabel(rowDimStr, r), cText, rowBg, text.align_left, szMat, false)
                    for c = 0 to colN - 1
                        int k = r * colN + c
                        float v = f_metric(matrixMetric, array.get(arrUp, k), array.get(arrDn, k), array.get(arrFl, k), array.get(arrSU, k), array.get(arrSD, k))
                        string txt = na(v) ? "-" : (isWin ? str.tostring(v, "0.0") : f_spct(v))
                        color cbg = matHeatmap ? f_shade(na(v) ? na : v - mid, cellMax, rowBg) : rowBg
                        color ctx = matHeatmap ? (na(v) ? cGrey : cText) : f_clr(v, mid)
                        f_cell(tblMat, c + 1, mr, txt, ctx, cbg, text.align_right, szMat, false)
                    float rv = f_metric(matrixMetric, array.get(rU, r), array.get(rD, r), array.get(rF, r), array.get(rSU, r), array.get(rSD, r))
                    string rtxt = na(rv) ? "-" : (isWin ? str.tostring(rv, "0.0") : f_spct(rv))
                    color rbg = matHeatmap ? f_shade(na(rv) ? na : rv - mid, allMax, cSecBg) : cSecBg
                    f_cell(tblMat, colN + 1, mr, rtxt, matHeatmap ? cText : f_clr(rv, mid), rbg, text.align_right, szMat, true)
                    mr += 1

            f_cell(tblMat, 0, mr, "ALL", cYellow, cSecBg, text.align_left, szMat, true)
            for c = 0 to colN - 1
                float cv = f_metric(matrixMetric, array.get(cU, c), array.get(cD, c), array.get(cF, c), array.get(cSU, c), array.get(cSD, c))
                string ctxt = na(cv) ? "-" : (isWin ? str.tostring(cv, "0.0") : f_spct(cv))
                color cbg2 = matHeatmap ? f_shade(na(cv) ? na : cv - mid, allMax, cSecBg) : cSecBg
                f_cell(tblMat, c + 1, mr, ctxt, matHeatmap ? cText : f_clr(cv, mid), cbg2, text.align_right, szMat, true)
            float gv = f_metric(matrixMetric, tU, tD, tF, tSU, tSD)
            f_cell(tblMat, colN + 1, mr, na(gv) ? "-" : (isWin ? str.tostring(gv, "0.0") : f_spct(gv)), f_clr(gv, mid), cSecBg, text.align_right, szMat, true)

    //------------------------------------------------
    // OVERALL STATS TABLE
    //------------------------------------------------
    if showOverall
        tblOvr := table.new(posOvr, 5, 14, border_color=cBorder, border_width=1, frame_color=cBorder, frame_width=1)
        int orow = 0
        f_title(tblOvr, orow, 5, "FILTERED CANDLES OVERVIEW", szOvr)
        orow += 1

        float gPct = totalCandles > 0 ? greenCount * 100.0 / totalCandles : na
        float rPct = totalCandles > 0 ? redCount * 100.0 / totalCandles : na
        float fPct = totalCandles > 0 ? flatCount * 100.0 / totalCandles : na
        float avgG = greenVolCnt > 0 ? greenVolSum / greenVolCnt : na
        float avgR = redVolCnt > 0 ? redVolSum / redVolCnt : na
        float avgT = totalVolCnt > 0 ? totalVolSum / totalVolCnt : na

        f_row(tblOvr, orow, array.from("CANDLE DISTRIBUTION", "Count", "% Candles", "Avg Volume", ""), array.from(cText, cText, cText, cText, cText), cSecBg, true, szOvr)
        table.merge_cells(tblOvr, 3, orow, 4, orow)
        orow += 1
        f_row(tblOvr, orow, array.from("Green", str.tostring(greenCount), f_pct(gPct), f_volume(avgG), ""), array.from(cGreen, cText, cText, cText, cText), orow % 2 == 0 ? cRowA : cRowB, false, szOvr)
        table.merge_cells(tblOvr, 3, orow, 4, orow)
        orow += 1
        f_row(tblOvr, orow, array.from("Red", str.tostring(redCount), f_pct(rPct), f_volume(avgR), ""), array.from(cRed, cText, cText, cText, cText), orow % 2 == 0 ? cRowA : cRowB, false, szOvr)
        table.merge_cells(tblOvr, 3, orow, 4, orow)
        orow += 1
        f_row(tblOvr, orow, array.from("Flat", str.tostring(flatCount), f_pct(fPct), "-", ""), array.from(cGrey, cText, cText, cText, cText), orow % 2 == 0 ? cRowA : cRowB, false, szOvr)
        table.merge_cells(tblOvr, 3, orow, 4, orow)
        orow += 1
        f_row(tblOvr, orow, array.from("Total", str.tostring(totalCandles), "100%", f_volume(avgT), ""), array.from(cText, cText, cText, cText, cText), orow % 2 == 0 ? cRowA : cRowB, false, szOvr)
        table.merge_cells(tblOvr, 3, orow, 4, orow)
        orow += 1

        float avgBody = array.size(bodyVals) > 0 ? array.avg(bodyVals) : na
        float avgRange = array.size(rangeVals) > 0 ? array.avg(rangeVals) : na

        f_row(tblOvr, orow, array.from("CANDLE SIZE", "Average", "P50", "P75", "P90"), array.from(cText, cText, cText, cText, cText), cSecBg, true, szOvr)
        orow += 1
        f_row(tblOvr, orow, array.from("Body %", f_pct(avgBody), f_pct(f_percentile(bodyVals, 0.50)), f_pct(f_percentile(bodyVals, 0.75)), f_pct(f_percentile(bodyVals, 0.90))), array.from(cText, cGrey, cGrey, cGrey, cGrey), orow % 2 == 0 ? cRowA : cRowB, false, szOvr)
        orow += 1
        f_row(tblOvr, orow, array.from("Body + Wick %", f_pct(avgRange), f_pct(f_percentile(rangeVals, 0.50)), f_pct(f_percentile(rangeVals, 0.75)), f_pct(f_percentile(rangeVals, 0.90))), array.from(cText, cGrey, cGrey, cGrey, cGrey), orow % 2 == 0 ? cRowA : cRowB, false, szOvr)
        orow += 1

        f_row(tblOvr, orow, array.from("VOLUME", "Average", "P50", "P75", "P90"), array.from(cText, cText, cText, cText, cText), cSecBg, true, szOvr)
        orow += 1
        f_row(tblOvr, orow, array.from("Volume", f_volume(avgT), f_volume(f_percentile(volVals, 0.50)), f_volume(f_percentile(volVals, 0.75)), f_volume(f_percentile(volVals, 0.90))), array.from(cText, cGrey, cGrey, cGrey, cGrey), orow % 2 == 0 ? cRowA : cRowB, false, szOvr)

//====================================================
// SELECTED DATE RANGE VERTICAL LINES
//====================================================
var line selectedFromLine = na
var line selectedToLine = na

if barstate.islast

    if not na(selectedFromLine)
        line.delete(selectedFromLine)
        selectedFromLine := na

    if not na(selectedToLine)
        line.delete(selectedToLine)
        selectedToLine := na

    if showRangeVerticalLines

        float lineTop = high == low ? high + syminfo.mintick : high

        if not na(fromBarIdx)
            selectedFromLine := line.new(x1=fromBarIdx, y1=low, x2=fromBarIdx, y2=lineTop, xloc=xloc.bar_index, extend=extend.both, color=color.lime, style=line.style_dashed, width=1)

        selectedToLine := line.new(x1=toDate, y1=low, x2=toDate, y2=lineTop, xloc=xloc.bar_time, extend=extend.both, color=color.red, style=line.style_dashed, width=1)
