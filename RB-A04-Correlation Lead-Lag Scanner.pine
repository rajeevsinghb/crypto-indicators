trendShift = input.int(20, "Trend Compare Shift (bars)", minval=1, maxval=250, group=g5, display=display.none,
     tooltip="Trend nikalne ke liye abhi ki correlation ko itne bars pehle (wahi window size) ki correlation se compare kiya jata hai. Chhota shift = recent change, bada shift = lamba trend.")
