showScanner = input.bool(true, "Show Scanner Table", group=g1, display=display.none,
     tooltip="Scanner table: asset list me se wo pairs jo ek doosre ko closely follow karte hain (Corr, pichla Corr, Trend, Lead-Lag). Settings Section 05 me. Size/position Section 09 me.")
