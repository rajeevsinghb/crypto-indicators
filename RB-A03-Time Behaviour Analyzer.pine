//====================================================
customRowDim = input.string("Day of Month", "Custom Rows", options=["Hour", "Weekday", "Day of Month", "Month"], group=g4, display=display.none,
     tooltip="Sirf Preset = Custom ho tab chalta hai. Summary table ki rows kis cheez se banengi.")
customColDim = input.string("Month", "Custom Matrix Columns", options=["None", "Hour", "Weekday", "Day of Month", "Month"], group=g4, display=display.none,
     tooltip="Sirf Preset = Custom ho tab chalta hai. Matrix table ke columns. Rows se alag chunein. None = matrix nahi banega.")

//====================================================
// 05. CALCULATION & SORTING
//====================================================
pctBasis = input.string("Close vs Previous Close", "Candle % Basis", options=["Close vs Previous Close", "Close vs Open", "High vs Open (Upside)", "Low vs Open (Downside)", "High-Low Range (Volatility)"], group=g5, display=display.none,
     tooltip="Har candle ka % kaise nikalein.\n• Close vs Previous Close (standard): pichli candle ke close se change; gap bhi count hota hai.\n• Close vs Open: (Close - Open) / Open. Sirf candle ke andar ka move.\n• High vs Open (Upside): (High - Open) / Open. Candle me open se kitna upar gaya (hamesha 0 ya +).\n• Low vs Open (Downside): (Low - Open) / Open. Open se kitna neeche gaya (hamesha 0 ya -).\n• High-Low Range (Volatility): (High - Low) / Open. Candle ki total range; kaun sa time/date sabse volatile hai.\n\nNote: last 3 options me Up/Down ya Win % ka matlab nahi hota (sab ek hi taraf hote hain). Inme Avg % ya Net % dekhein.")
matrixMetric = input.string("Avg % per candle", "Matrix Cell Value", options=["Net % (sum)", "Avg % per candle", "Win Rate %", "Sum Up %", "Sum Down %"], group=g5, display=display.none,
     tooltip="Matrix ke har dabbe me kya dikhe.\n• Net % (sum): sab candles ka % jod (positive + negative).\n• Avg % per candle: Net % / candles ki ginti.\n• Win Rate %: green candles / (green + red) x 100. 50% se upar = strong.\n• Sum Up %: sirf positive candles ka jod.\n• Sum Down %: sirf negative candles ka jod.")
sortStr = input.string("Natural order", "Sort Summary Rows", options=["Natural order", "Net % (high to low)", "Win Rate % (high to low)", "Avg % (high to low)"], group=g5, display=display.none,
     tooltip="Summary table ki rows ka order.\n• Natural order: 00:00 se 23:00, ya date 1 se 31, ya Jan se Dec.\n• Baaki options: sabse strong row upar, sabse weak neeche.")
minSamples = input.int(3, "Min Candles for Best / Worst", minval=1, group=g5, display=display.none,
     tooltip="Strongest / Weakest (aur star / down marker) sirf unhi rows me chuna jayega jinme kam se kam itni candles hon. Kam samples wali rows se galat nateeja na aaye, isliye.")

