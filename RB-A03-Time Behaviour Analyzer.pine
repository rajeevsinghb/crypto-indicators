     tooltip="Kis hour se candles lenge. Sirf ek hour dekhna ho to From = To rakhein (e.g. 14 aur 14). Sab hours ke liye 0 se 23.\nFrom > To ho to overnight wrap hoga (e.g. 22 se 3). Hour filter ke liye intraday (1H) chart chahiye.")
hourTo = input.int(23, "Hour To (0-23)", minval=0, maxval=23, group=g3, display=display.none,
     tooltip="Kis hour tak candles lenge. Hour From ke saath use hota hai.")
fMon = input.bool(true, "Mon", group=g3, inline="wd", display=display.none, tooltip="Weekday filter: jis din ka tick hata denge, us din ki candles analysis se bahar ho jayengi. Example: sirf Mon-Fri dekhne ke liye Sat aur Sun OFF karein.")
fTue = input.bool(true, "Tue", group=g3, inline="wd", display=display.none, tooltip="Tuesday ki candles include karein.")
fWed = input.bool(true, "Wed", group=g3, inline="wd", display=display.none, tooltip="Wednesday ki candles include karein.")
fThu = input.bool(true, "Thu", group=g3, inline="wd", display=display.none, tooltip="Thursday ki candles include karein.")
fFri = input.bool(true, "Fri", group=g3, inline="wd", display=display.none, tooltip="Friday ki candles include karein.")
fSat = input.bool(true, "Sat", group=g3, inline="wd2", display=display.none, tooltip="Saturday ki candles include karein.")
fSun = input.bool(true, "Sun", group=g3, inline="wd2", display=display.none, tooltip="Sunday ki candles include karein.")
monthFrom = input.int(1, "Month From (1-12)", minval=1, maxval=12, group=g3, display=display.none,
     tooltip="Kis month se candles lenge (1 = Jan ... 12 = Dec). Example: sirf Oct-Dec ke liye 10 aur 12.")
monthTo = input.int(12, "Month To (1-12)", minval=1, maxval=12, group=g3, display=display.none,
     tooltip="Kis month tak candles lenge. From > To ho to year-end wrap hoga (e.g. 11 se 2).")
domFrom = input.int(1, "Date From (1-31)", minval=1, maxval=31, group=g3, display=display.none,
     tooltip="Month ki kaun si date se candles lenge. Example: sirf 1 se 7 tareekh dekhne ke liye 1 aur 7.")
domTo = input.int(31, "Date To (1-31)", minval=1, maxval=31, group=g3, display=display.none,
     tooltip="Month ki kaun si date tak candles lenge.")
minAbsPct = input.float(0.0, "Ignore Candles Smaller Than (%)", minval=0.0, step=0.05, group=g3, display=display.none,
     tooltip="Is % se chhoti candles flat (neutral) maani jayengi - na Up me, na Down me. Noise hatane ke liye. 0 = koi filter nahi.")

//====================================================
