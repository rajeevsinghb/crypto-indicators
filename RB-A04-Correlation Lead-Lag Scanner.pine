//@version=6
indicator("RB-A04-Correlation Lead-Lag Scanner", shorttitle="RB-A04", overlay=true, max_lines_count=500)

//====================================================
// INPUT GROUPS  (flow: Quick Start -> Assets -> Range -> Calc -> Scanner -> Windows -> Classification -> Lead-Lag -> Style)
//====================================================
string g1 = "01. QUICK START (tables on/off + pair + page)"
string g2 = "02. ASSET LIST"
string g3 = "03. DATE / RANGE"
string g4 = "04. DATA CALCULATION"
string g5 = "05. SCANNER SETTINGS"
