sumSizeStr = input.string("Small", "Summary Table Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=g6, display=display.none,
     tooltip="Table ke text ka size. Tiny = sabse chhota, Huge = sabse bada. Table bahut bada lage to Tiny karein.")
sumPosStr = input.string("Top Right", "Summary Table Position", options=["Top Right", "Top Left", "Top Center", "Middle Right", "Middle Left", "Bottom Right", "Bottom Left", "Bottom Center"], group=g6, display=display.none,
     tooltip="Chart par table kahan dikhe. Default sabhi tables Top Right par hain, isliye ek time par ek hi table ON rakhein. Ek se zyada ON karne par unki position alag-alag karein, warna wo ek doosre ke upar aa jayengi.")
hideEmptyRows = input.bool(true, "Hide Rows With No Data", group=g6, display=display.none,
     tooltip="ON: jin rows me ek bhi candle nahi hai (e.g. date 31 kisi month me nahi) wo chhup jayengi. Matrix table par bhi lagta hai.")
highlightBW = input.bool(true, "Highlight Best / Worst Row", group=g6, display=display.none,
     tooltip="ON: sabse strong row par star (green background) aur sabse weak row par down marker (red background) lagega. Ranking Net % par hoti hai.")

//====================================================
