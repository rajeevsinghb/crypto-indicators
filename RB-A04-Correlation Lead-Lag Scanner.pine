secLead = input.bool(true, "Pair Section B: Lead-Lag & Speed", group=g1, display=display.none,
     tooltip="Har window me best lag: kaun sa asset leader hai, kaun follower, kitne bars/time baad follow karta hai, aur follower leader ke 1% move par kitna move karta hai (Beta).")
secProfile = input.bool(false, "Pair Section C: Lag Profile (primary window)", group=g1, display=display.none,
     tooltip="Primary window ke liye har lag (-L se +L) par correlation, bar ke saath. Lead-lag ka poora shape ek nazar me dikhta hai.")
secPerf = input.bool(true, "Pair Section D: Performance & Risk", group=g1, display=display.none,
     tooltip="Har window me dono assets ka return, spread (A - B), Beta (B on A), R-squared aur volatility.")
rowsPerPage = input.int(16, "Rows Per Page (0 = All)", minval=0, maxval=100, group=g1, display=display.none,
     tooltip="Scanner list lambi ho to ek page me kitni rows dikhani hain (e.g. 12 ya 16). 0 = saari rows ek saath. TradingView me table scroll nahi hoti, isliye Page No. se step by step dekhein.")
