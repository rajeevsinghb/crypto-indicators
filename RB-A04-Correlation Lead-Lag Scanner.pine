//====================================================
scanSizeStr = input.string("Small", "Scanner Table Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=g9, display=display.none,
     tooltip="Scanner table ke text ka size. Tiny = sabse chhota, Huge = sabse bada.")
scanPosStr = input.string("Top Right", "Scanner Table Position", options=["Top Right", "Top Left", "Top Center", "Middle Right", "Middle Left", "Bottom Right", "Bottom Left", "Bottom Center"], group=g9, display=display.none,
     tooltip="Scanner table chart par kahan dikhe.")
