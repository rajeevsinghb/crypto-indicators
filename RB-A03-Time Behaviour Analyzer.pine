//@version=6
indicator("RB-A03-Time Behaviour Analyzer", shorttitle="RB-A03", overlay=true, max_labels_count=500, max_lines_count=500)

//====================================================
// INPUT GROUPS  (flow: Quick Start -> Range -> Filters -> Custom -> Calc -> Tables -> Verify)
//====================================================
string g1 = "01. QUICK START (table on/off + preset + page)"
string g2 = "02. DATE / RANGE"
string g3 = "03. FILTERS"
string g4 = "04. CUSTOM GROUPING (sirf Preset = Custom ho tab)"
string g5 = "05. CALCULATION & SORTING"
string g6 = "06. SUMMARY TABLE"
string g7 = "07. MATRIX TABLE"
string g8 = "08. OVERALL STATS TABLE"
string g9 = "09. CHART VERIFY TOOLS"

//====================================================
// 01. QUICK START
//====================================================
showSummary = input.bool(true, "Show Summary Table", group=g1, display=display.none,
     tooltip="Summary table: har row ke liye Up #, Down #, Win %, Up % (sum), Down % (sum), Net %, Avg %. Strongest aur Weakest row bhi dikhti hai. Size/position Section 06 me.")
showMatrix = input.bool(false, "Show Matrix Table", group=g1, display=display.none,
     tooltip="Matrix table: Rows x Columns ka grid (e.g. Date x Month). Har dabbe me Matrix Cell Value (Section 05) dikhta hai; 'ALL' row/column total deta hai. Preset me Columns = None ho (Month only / Hour only) to matrix nahi banta. Size/position Section 07 me.")
showOverall = input.bool(false, "Show Overall Stats Table", group=g1, display=display.none,
     tooltip="Filters ke baad bachi candles ka overview: Green / Red / Flat ginti, avg volume, Body % aur Body+Wick % ke P50/P75/P90, aur Volume percentiles. Size/position Section 08 me.")
presetStr = input.string("Date x Month", "Analysis Preset", options=["Date x Month", "Hour x Weekday", "Hour x Date", "Weekday x Month", "Month only", "Hour only", "Custom"], group=g1, display=display.none,
     tooltip="Sabse pehle yahan ready-made analysis chunein. Baaki settings isi ke hisaab se kaam karti hain.\n\n• Date x Month: Rows = date 1-31, Columns = Jan-Dec. Har month ki har date par market positive/negative kaisa raha. (Daily chart)\n• Hour x Weekday: Rows = 24 hours, Columns = Mon-Sun. Kis din kaun sa hour strong/weak. (1H chart)\n• Hour x Date: Rows = 24 hours, Columns = date 1-31. Har date ke 1-24 hours ka alag result. (1H chart)\n• Weekday x Month: Rows = Mon-Sun, Columns = Jan-Dec. (Daily chart)\n• Month only: sirf Jan-Dec ka summary. (Daily chart)\n• Hour only: sirf 24 hours ka summary. (1H chart)\n• Custom: Section 04 ke Custom Rows/Columns use honge.")
rowsPerPage = input.int(16, "Rows Per Page (0 = All)", minval=0, maxval=100, group=g1, display=display.none,
     tooltip="Rows bahut zyada hon aur table screen se bahar jaye to yahan ek page me kitni rows dikhani hain wo set karein (e.g. 12 ya 16). 0 = saari rows ek saath. Default 16 (standard screen me fit hota hai); chhoti screen par 12 rakhein.\nSummary aur Matrix dono par lagta hai. TradingView me table scroll nahi hoti, isliye Page No. se pages badalte hain.")
pageNo = input.int(1, "Page No.", minval=1, maxval=20, group=g1, display=display.none,
     tooltip="Rows Per Page set hone par kaun sa page dikhana hai (1, 2, 3...). Table me 'Page x / y' likha aata hai. Total pages se zyada number dein to last page dikhega.")

//====================================================
// 02. DATE / RANGE  (RB-A02 jaisa)
//====================================================
useChartFirstAsFrom = input.bool(true, "Use Chart First Candle as Selected From", group=g2, display=display.none,
     tooltip="ON: analysis chart ki sabse pehli candle se shuru hoga. OFF: neeche ki 'Manual Selected From' date use hogi.")
manualFromDate = input.time(timestamp("01 Jan 2026 00:00 +0530"), "Manual Selected From", group=g2, display=display.none,
     tooltip="Analysis start date-time. Sirf tab chalegi jab upar wala 'Use Chart First Candle' OFF ho.")
toDate = input.time(timestamp("31 Dec 2026 23:59 +0530"), "Selected To", group=g2, display=display.none,
     tooltip="Analysis end date-time. Is date ke baad ki candles count nahi hongi.")
showRangeVerticalLines = input.bool(true, "Show Selected From / To Vertical Lines", group=g2, display=display.none,
     tooltip="ON: chart par Selected From (green dashed) aur Selected To (red dashed) vertical lines dikhengi, taaki range ek nazar me pata chale.")
displayTz = input.string("Asia/Kolkata", "Display Timezone", group=g2, display=display.none,
     tooltip="IANA timezone, e.g. Asia/Kolkata, UTC, America/New_York.\nTable ki dates aur Hour / Weekday / Date / Month ki grouping isi timezone me hoti hai. Isse chart timezone ke saath same rakhein.")

//====================================================
